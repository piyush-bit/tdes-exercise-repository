{
  "lab_id": "cs2001-lab07",
  "title": "Binary Tree & BST Operations in C",
  "version": "1.0.0",
  "language": "c",
  "runner_image": "lab-c-runner:v1.0",
  "local_entrypoint": "make test-public",
  "grading": [
    {
      "command": "make test-public",
      "points": 0,
      "public": true
    },
    {
      "command": "make test-submission-traversals",
      "points": 3,
      "public": false
    },
    {
      "command": "make test-submission-insertion",
      "points": 3,
      "public": false
    },
    {
      "command": "make test-submission-deletion",
      "points": 4,
      "public": false
    }
  ],
  "submission": {
    "include_paths": [
      "binary_tree.c"
    ],
    "private_globs": [
      "reference/*",
      "tests_private/*"
    ],
    "exclude_globs": [
      "*.o",
      "bin/*",
      "*.tar.gz"
    ]
  },
  "limits": {
    "memory_mb": 256,
    "timeout_seconds": 10
  }
