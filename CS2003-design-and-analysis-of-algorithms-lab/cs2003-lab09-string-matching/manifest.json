{
  "lab_id": "cs2003-lab09",
  "title": "Security Log Pattern & String Matcher",
  "version": "1.0.0",
  "language": "cpp",
  "runner_image": "lab-cpp-runner:v1.0",
  "local_entrypoint": "make test-public",
  "grading": [
    {
      "command": "make test-public",
