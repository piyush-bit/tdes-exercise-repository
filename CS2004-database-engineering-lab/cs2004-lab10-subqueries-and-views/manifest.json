{
  "lab_id": "cs2004-lab10",
  "title": "Executive Dashboard Subqueries & Reporting Views",
  "version": "1.0.0",
  "language": "sql",
  "runner_image": "lab-sql-runner:v1.0",
  "local_entrypoint": "make test-public",
  "grading": [
    {
      "command": "make test-public",
      "points": 0,
      "public": true
    },
    {
      "command": "make test-submission-nested-subqueries",
      "points": 5,
      "public": false
    },
    {
      "command": "make test-submission-reporting-views",
      "points": 5,
      "public": false
    }
  ],
  "submission": {
    "include_paths": [
      "solution.sql"
    ],
    "private_globs": [
      "reference/*",
      "tests_private/*"
    ],
    "exclude_globs": [
      "*.tar.gz"
    ]
  },
  "limits": {
    "memory_mb": 256,
    "timeout_seconds": 10
  }
}
