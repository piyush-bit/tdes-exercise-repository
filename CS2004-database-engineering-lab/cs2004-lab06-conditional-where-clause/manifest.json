{
  "lab_id": "cs2004-lab06",
  "title": "Healthcare Patient Audit & Clinical Triage Filter",
  "version": "1.0.0",
  "language": "sql",
  "runner_image": "lab-sql-runner:v1.0",
  "local_entrypoint": "make test-public",
  "grading": [
    {
      "command": "make test-public",
      "points": 0,
      "public": true
    },
    {
      "command": "make test-submission-comparison-filtering",
      "points": 5,
      "public": false
    },
    {
      "command": "make test-submission-range-filtering",
      "points": 5,
      "public": false
    }
  ],
  "submission": {
    "include_paths": [
      "solution.sql"
    ],
    "private_globs": [
      "reference/*",
      "tests_private/*"
    ],
    "exclude_globs": [
      "*.tar.gz",
      "__pycache__/*",
      "*.pyc"
    ]
  },
  "limits": {
    "memory_mb": 256,
    "timeout_seconds": 5
  }
}
