{
  "lab_id": "cs2002-lab03",
  "title": "Crypto Vault & Friend Audit Inspector",
  "version": "1.0.0",
  "language": "cpp",
  "runner_image": "lab-cpp-runner:v1.0",
  "local_entrypoint": "make test-public",
  "grading": [
    {
      "command": "make test-public",
      "points": 0,
      "public": true
    },
    {
      "command": "make test-submission-function-overloading",
      "points": 5,
      "public": false
    },
    {
      "command": "make test-submission-friend-audit",
      "points": 5,
      "public": false
    }
  ],
  "submission": {
    "include_paths": [
      "crypto_vault.cpp"
    ],
    "private_globs": [
      "reference/*",
      "tests_private/*"
    ],
    "exclude_globs": [
      "*.o",
      "bin/*",
      "*.tar.gz"
    ]
  },
  "limits": {
    "memory_mb": 256,
    "timeout_seconds": 5
  }
}
