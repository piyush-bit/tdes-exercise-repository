{
  "lab_id": "cs3001-lab05",
  "title": "Automaton for Even Number of 0s and 1s",
  "version": "1.0.0",
  "language": "c",
  "runner_image": "lab-c-runner:v1.0",
  "local_entrypoint": "make test-public",
  "grading": [
    {
      "command": "make test-public",
      "points": 0,
      "public": true
    },
    {
      "command": "make test-submission-even-parity",
      "points": 5,
      "public": false
    },
    {
      "command": "make test-submission-odd-parity",
      "points": 5,
      "public": false
    }
  ],
  "submission": {
    "include_paths": [
      "even_parity.c"
    ],
    "private_globs": [
      "reference/*",
      "tests_private/*"
    ],
    "exclude_globs": [
      "*.o",
      "bin/*",
      "*.tar.gz"
    ]
  },
  "limits": {
    "memory_mb": 256,
    "timeout_seconds": 10
  }
}
