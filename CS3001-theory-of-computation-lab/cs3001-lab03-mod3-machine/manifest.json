{
  "lab_id": "cs3001-lab03",
  "title": "Binary Modulo 3 Automaton",
  "version": "1.0.0",
  "language": "c",
  "runner_image": "lab-c-runner:v1.0",
  "local_entrypoint": "make test-public",
  "grading": [
    {
      "command": "make test-public",
      "points": 0,
      "public": true
    },
    {
      "command": "make test-submission-mod3-eval",
      "points": 5,
      "public": false
    },
    {
      "command": "make test-submission-mod3-large",
      "points": 5,
      "public": false
    }
  ],
  "submission": {
    "include_paths": [
      "mod3_machine.c"
    ],
    "private_globs": [
      "reference/*",
      "tests_private/*"
    ],
    "exclude_globs": [
      "*.o",
      "bin/*",
      "*.tar.gz"
    ]
  },
  "limits": {
    "memory_mb": 256,
    "timeout_seconds": 10
  }
}
